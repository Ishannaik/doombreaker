{
  "manifest_version": 3,
  "name": "DoomBreaker",
  "version": "0.1.0",
  "description": "The page breaks as you doom-scroll. Damage heals when you stop.",
  "permissions": ["storage", "declarativeNetRequest", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["meter.js", "sites.js", "content.js"],
      "css": ["effects.css"],
      "run_at": "document_start"
    }
  ]
}
