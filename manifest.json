{
  "manifest_version": 3,
  "name": "DoomBreaker",
  "version": "0.1.0",
  "description": "The page breaks as you doom-scroll. Damage heals when you stop.",
  "permissions": ["storage", "declarativeNetRequest"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://*.reddit.com/*",
        "*://instagram.com/*",
        "*://www.instagram.com/*",
        "*://youtube.com/*",
        "*://www.youtube.com/*",
        "*://linkedin.com/*",
        "*://www.linkedin.com/*"
      ],
      "js": ["meter.js", "content.js"],
      "css": ["effects.css"],
      "run_at": "document_start"
    }
  ]
}
